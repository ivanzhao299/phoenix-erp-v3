{
  "name": "phoenix-erp",
  "version": "3.0.0",
  "private": true,
  "description": "Phoenix ERP V3 Monorepo — pnpm workspaces",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter phoenix-erp-v3-nest start:dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter phoenix-erp-v3-nest build",
    "build": "pnpm build:api && pnpm build:web",
    "lint:api": "pnpm --filter phoenix-erp-v3-nest lint",
    "lint:web": "pnpm --filter web lint",
    "lint": "pnpm lint:api && pnpm lint:web",
    "typecheck:api": "pnpm --filter phoenix-erp-v3-nest exec tsc --noEmit",
    "typecheck:web": "pnpm --filter web typecheck",
    "typecheck": "pnpm typecheck:api && pnpm typecheck:web",
    "test:api": "pnpm --filter phoenix-erp-v3-nest test",
    "test:web": "pnpm --filter web test",
    "test:unit": "pnpm test:api && pnpm test:web",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "lint:web:inventory": "node scripts/lint/web-lint.mjs inventory",
    "lint:web:baseline:update": "node scripts/lint/web-lint.mjs update",
    "lint:web:ratchet": "node scripts/lint/web-lint.mjs ratchet",
    "lint:web:changed": "node scripts/lint/web-lint.mjs changed",
    "test:lint": "node --test scripts/lint/web-lint.test.mjs",
    "verify:changed": "pnpm test:lint && pnpm lint:api && pnpm lint:web:changed && pnpm lint:web:ratchet && pnpm typecheck && pnpm test:unit && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "sharp",
      "unrs-resolver"
    ]
  }
}
