# /etc/phoenix-webhook.env — 服务器环境变量（不提交到 Git）
# 复制到 /etc/phoenix-webhook.env 后填入真实值
#
# 生成随机令牌：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# 同一个值也要写入 GitHub Actions Secret: DEPLOY_WEBHOOK_TOKEN

# ── 必填 ──────────────────────────────────────────────────────────────────────
DEPLOY_WEBHOOK_TOKEN=your-random-token-here

# ghcr.io 登录（用于 docker pull）
# Token 权限：read:packages 即可
GHCR_USER=ivanzhao299
GHCR_TOKEN=ghp_your_classic_pat_here

# ── 路径（默认值通常够用）────────────────────────────────────────────────────
DEPLOY_PATH=/root/phoenix-erp
DEPLOY_SCRIPT=/root/phoenix-erp/deploy/deploy.sh
DEPLOY_LOG=/var/log/phoenix-deploy.log
WEBHOOK_PORT=9000

# ── 可选：部署完成通知 ────────────────────────────────────────────────────────
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx
# ALERT_WEBHOOK_TYPE=feishu   # feishu / dingtalk / slack
