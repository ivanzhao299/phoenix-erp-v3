# Phoenix ERP V3 — .gitignore

# Node
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
**/build/
.next/
**/.next/
tsconfig.build.tsbuildinfo
**/tsconfig.build.tsbuildinfo

# Runtime / logs
.logs/
.claude/
coverage/
**/coverage/
*.log

# Environment files (敏感)
.env
.env.local
.env.*.local
.env.docker

# OS files
.DS_Store
Thumbs.db
.smbdelete*
**/.smbdelete*

# IDE
.vscode/
.idea/

# 本地归档 / 大文件
_archive/
**/_archive/
*.sql.gz

# 数据库备份（禁止进入 Git）
backups/
*.dump
*.dump.gz
*.sql.dump
*.backup

# 测试产物 / 临时输出
apps/api/*.txt
*_output.txt
test_output.txt
*.tmp
tmp/
cache/

# 生产真实 schema（fetch-prod-schema.sh 取回，本地验证用，不入库）
scripts/.prod-schema.sql

# 畅捷通探针 token 缓存（含敏感 token，严禁提交）
scripts/.yonyou-*.json

# Bug intake 本地收件箱（含生产截图/附件与完整上下文，仅作运行时缓存）
docs/ops/runs/bug-intake-inbox/
