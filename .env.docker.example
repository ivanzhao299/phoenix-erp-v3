# ═══════════════════════════════════════════════════════════════
#  Phoenix ERP V3 — docker-compose 环境变量模板
#  使用: cp .env.docker.example .env && 填入真实值 && docker compose up -d
# ═══════════════════════════════════════════════════════════════

# 运行模式
NODE_ENV=production

# Postgres
DB_USER=phoenix_v3
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=phoenix_erp
DB_PORT=5432

# 对外端口（Nginx 反代 → 127.0.0.1:3000 / 3100）
API_PORT=3100
WEB_PORT=3000

# JWT (生成: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOMBYTES_48_HEX
JWT_SECRET_PREV=
JWT_EXPIRES_IN=8h

# CORS（生产域名，多个用逗号分隔）
CORS_ORIGINS=https://erp.eggslao.com

# 日志级别（生产推荐 warn，调试用 debug）
LOG_LEVEL=warn

# 镜像标签（CI/CD 自动注入 latest；手动指定版本用 sha-<commit>）
API_IMAGE=ghcr.io/ivanzhao299/phoenix-erp-v3/api:latest
WEB_IMAGE=ghcr.io/ivanzhao299/phoenix-erp-v3/web:latest
