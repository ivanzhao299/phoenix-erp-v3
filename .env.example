# ═══════════════════════════════════════════════════════════════
#  Phoenix ERP V3 — 生产环境变量模板
#  使用：cp .env.example .env  然后填写所有必填项
#  注意：.env 已在 .gitignore 中，不会提交到仓库
# ═══════════════════════════════════════════════════════════════

# ── 数据库 ─────────────────────────────────────────────────────
DB_USER=phoenix_v3
DB_PASSWORD=替换为强密码_至少16位
DB_NAME=phoenix_erp
DB_PORT=5432

# ── JWT ────────────────────────────────────────────────────────
# 必须至少 32 字符，用 openssl rand -hex 32 生成
JWT_SECRET=替换为64位随机字符串
# 轮换密钥时将旧 JWT_SECRET 移到此处，新值填入上方（零停机轮换）
JWT_SECRET_PREV=

JWT_EXPIRES_IN=8h

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=https://erp.eggslao.com

# ── 日志 ───────────────────────────────────────────────────────
LOG_LEVEL=warn

# ── 畅捷通好业财对接（可选）──────────────────────────────────
CHANJET_APP_KEY=
CHANJET_APP_SECRET=
CHANJET_MIN_REQUEST_INTERVAL_MS=250
CHANJET_MONTHLY_LOCAL_BUDGET=20000
CHANJET_DAILY_LOCAL_BUDGET=650
CHANJET_DAILY_WRITE_BUDGET=20
CHANJET_READ_CACHE_TTL_MS=30000
CHANJET_READ_CACHE_MAX_ENTRIES=500
CHANJET_ORG_ID=
CHANJET_CERT=
CHANJET_MSG_SECRET=

# ── 镜像版本（留空则用 latest）────────────────────────────────
# API_IMAGE=ghcr.io/ivanzhao299/phoenix-erp-v3/api:sha-xxxxxx
# WEB_IMAGE=ghcr.io/ivanzhao299/phoenix-erp-v3/web:sha-xxxxxx
