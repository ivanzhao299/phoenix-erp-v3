# Phoenix ERP Staging Environment Example
# Do not put real secrets in this file.

NODE_ENV=staging
APP_ENV=staging

# Database
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=phoenix_erp_staging

# Network
PUBLIC_API_BASE_URL=
STAGING_WEB_URL=
STAGING_API_URL=
CORS_ORIGINS=
COOKIE_DOMAIN=
COOKIE_SECURE=true

# Auth
JWT_SECRET=
JWT_SECRET_PREV=
JWT_EXPIRES_IN=8h

# Store Payment feature flags
STORE_PAYMENT_ENABLED=true
STORE_PAYMENT_ATTACHMENT_PROTECTED_STREAMING=true
STORE_PAYMENT_RAW_URL_DISABLED=true
STORE_PAYMENT_LEGACY_UPLOADS_DISABLED=true

# File storage
FILE_STORAGE_PATH=
STAGING_FILE_STORAGE_PATH=
UPLOAD_ROOT=

# Logging / audit
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
ATTACHMENT_DENIED_AUDIT_ENABLED=true

# Frontend
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_ENV=staging

# Chanjet / third-party integration placeholders. Keep empty unless a staging integration Gate approves them.
CHANJET_APP_KEY=
CHANJET_APP_SECRET=
CHANJET_ORG_ID=
CHANJET_CERT=
CHANJET_MSG_SECRET=
