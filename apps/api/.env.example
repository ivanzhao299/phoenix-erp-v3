# ═══════════════════════════════════════════════════════════════
#  Phoenix ERP V3 — 环境变量配置模板
#  复制本文件为 .env，填写真实值后启动服务
#  ⚠️  .env 文件严禁提交到 Git，已加入 .gitignore
# ═══════════════════════════════════════════════════════════════

# ── 运行模式 ──────────────────────────────────────────────────
NODE_ENV=production         # development | production | test

# ── 数据库 (PostgreSQL) ──────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=phoenix_app         # 建议使用专用账号，禁止使用 postgres superuser
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=phoenix_erp

# ── JWT 安全密钥 ───────────────────────────────────────────────
# 生成命令: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 长度要求: ≥ 64 字符，全随机
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO_RANDOMBYTES_64_HEX

# ── 服务端口 ───────────────────────────────────────────────────
PORT=3000

# ── 跨域白名单 (逗号分隔) ─────────────────────────────────────
CORS_ORIGINS=http://localhost:5180,https://your-production-domain.com

# ── 日志级别 ───────────────────────────────────────────────────
LOG_LEVEL=warn              # debug | info | warn | error

# ── IoT 设备集成 (可选) ───────────────────────────────────────
# IOT_API_BASE=https://iot.example.com
# IOT_TOKEN=your_iot_token

# ── 生产必填 Checklist ────────────────────────────────────────
# [ ] JWT_SECRET 已使用 crypto.randomBytes(64) 生成
# [ ] DB_PASSWORD 为强密码（≥16位，含数字+特殊字符）
# [ ] NODE_ENV=production
# [ ] CORS_ORIGINS 仅包含允许的域名
# [ ] 本文件权限设置为 600 (chmod 600 .env)
