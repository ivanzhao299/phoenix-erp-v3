{
  "name": "phoenix-erp-v3-nest",
  "version": "1.0.0",
  "description": "Phoenix ERP V3.0 Backend - NestJS Architecture",
  "author": "Antigravity",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:smoke": "bash scripts/smoke-test.sh",
    "test:regr:system": "bash scripts/system-regression.sh",
    "test:regr:breeding": "bash scripts/breeding-regression.sh",
    "test:regr:packaging": "bash scripts/packaging-regression.sh",
    "test:regr:wms": "bash scripts/wms-regression.sh",
    "test:regr:pos-store": "bash scripts/pos-store-regression.sh",
    "test:regr:order": "bash scripts/order-regression.sh",
    "test:regr:finance": "bash scripts/finance-regression.sh",
    "test:regr:quality": "bash scripts/quality-regression.sh",
    "test:regr:pda": "bash scripts/pda-regression.sh",
    "test:regr:bi": "bash scripts/bi-regression.sh",
    "test:e2e": "bash scripts/e2e-order-flow.sh",
    "test:regr": "bash scripts/system-regression.sh && bash scripts/breeding-regression.sh && bash scripts/packaging-regression.sh && bash scripts/wms-regression.sh && bash scripts/pos-store-regression.sh && bash scripts/order-regression.sh && bash scripts/finance-regression.sh && bash scripts/quality-regression.sh && bash scripts/pda-regression.sh && bash scripts/bi-regression.sh && bash scripts/e2e-order-flow.sh"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "nestjs-cls": "^3.6.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.10",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.1.3"
  }
}
